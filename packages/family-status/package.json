    "build": "tsc",
    "check": "tsc --project tsconfig.check.json",
    "generate-model": "pnpm openapi-zod-client ./open-api/FamilyStatus_v1.0.yaml -o ./src/model/generated/api.ts",
    "clean-generated": "pnpm exec rm ./src/model/generated/api.ts"
  },
