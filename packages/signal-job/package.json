{
  "name": "signal-job",
  "version": "1.0.0",
  "type": "module",
  "main": "dist",
  "scripts": {
    "test": "vitest",
    "test:it": "vitest integration",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "start": "node  --no-warnings --loader ts-node/esm ./src/index.ts",
    "build": "tsc",
    "check": "tsc --project tsconfig.check.json"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cron": "^4.3.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.0",
    "pdnd-common": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@pagopa/eslint-config": "^3.0.0",
    "@types/node": "^22.0.0",
    "dotenv-flow": "^4.1.0",
    "eslint": "^8.44.0",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^0.33.0"
  }
}